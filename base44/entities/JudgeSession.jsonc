{
  "name": "JudgeSession",
  "type": "object",
  "properties": {
    "judge_email": {
      "type": "string",
      "description": "Email of the judge user"
    },
    "judge_name": {
      "type": "string",
      "description": "Name of the judge"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether judge support is currently active"
    },
    "needs_help": {
      "type": "boolean",
      "default": false,
      "description": "Judge has requested assistance"
    },
    "last_activity": {
      "type": "string",
      "description": "Description of judge's last action"
    },
    "notes": {
      "type": "string",
      "description": "Admin notes about this judge"
    }
  },
  "required": [
    "judge_email",
    "judge_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}