{
  "name": "ContactMessage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the person contacting"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the sender"
    },
    "subject": {
      "type": "string",
      "description": "Subject of the message"
    },
    "message": {
      "type": "string",
      "description": "The message content"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "read",
        "replied"
      ],
      "default": "new",
      "description": "Status of the message"
    },
    "admin_response": {
      "type": "string",
      "description": "Admin's response to the message"
    },
    "responded_by": {
      "type": "string",
      "description": "Email of the admin who responded"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the response was sent"
    }
  },
  "required": [
    "name",
    "email",
    "subject",
    "message"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}