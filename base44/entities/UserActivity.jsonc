{
  "name": "UserActivity",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the user"
    },
    "current_page": {
      "type": "string",
      "description": "Current page the user is on"
    },
    "last_action": {
      "type": "string",
      "description": "Description of last action taken"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether user is currently active"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Last activity timestamp"
    }
  },
  "required": [
    "user_email",
    "user_name"
  ],
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}