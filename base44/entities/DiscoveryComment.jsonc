{
  "name": "DiscoveryComment",
  "type": "object",
  "properties": {
    "discovery_id": {
      "type": "string",
      "description": "ID of the discovery being commented on"
    },
    "content": {
      "type": "string",
      "description": "Comment content"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of the comment author"
    },
    "likes": {
      "type": "number",
      "default": 0,
      "description": "Number of likes on the comment"
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of users who liked"
    }
  },
  "required": [
    "discovery_id",
    "content"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}